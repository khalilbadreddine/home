# ─────────────────────────────────────────────────────────────
# TherecipeSeeker — put in your keys and it works.
# Every variable is OPTIONAL except nothing: the app runs with zero of them
# (local SQLite, generated owner key, no AI until you run Ollama).
# ─────────────────────────────────────────────────────────────

# DATABASE — free online: Neon (https://neon.tech) → copy the pooled connection string
# Leave empty for a local file database at ./data/local.db (perfect for local dev).
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# OWNER LOGIN (email + password on the /admin page)
# Without these, a password is generated on first run and saved to data/owner-credentials.txt
# ADMIN_EMAIL=you@gmail.com
# ADMIN_PASSWORD=choose-something-long

# GOOGLE LOGIN (optional — https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI:  {YOUR_SITE_URL}/api/auth/callback/google
# Sign in with the SAME email as ADMIN_EMAIL to become the owner.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AUTH SECRET — NextAuth (any long string; auto-generated & stored if empty)
# AUTH_SECRET=

# FREE LOCAL AI — Ollama (https://ollama.com) — free, private, offline
# On the machine that runs the site:  ollama serve  +  ollama pull llama3.1
# If Ollama runs elsewhere (VPS, pi, another PC), point at it:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# NEWSLETTER SENDING (optional) — free: https://resend.com (100 emails/day)
# RESEND_API_KEY=

# PUBLIC SITE URL (used for share links / docs)
# NEXT_PUBLIC_SITE_URL=https://therecipeseeker.vercel.app
