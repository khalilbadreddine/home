        "energy": 4,
        "info_type": "number",
        "key_terms": [
          "fourteen kilometres"
        ]
      },
      "intent": "Open on a number with no context so the viewer asks 'fourteen kilometres of what?'. Open sea under the number hints at the answer.",
      "strategy": "typography",
      "camera": {
        "move": "push_in",
        "intensity": 0.35
      },
      "layers": [
        {
          "type": "video",
