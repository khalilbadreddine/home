{
  "version": "1.0",
  "meta": {
    "title": "The 14 Kilometres That Move the World",
    "slug": "demo",
    "fps": 30,
    "width": 1920,
    "height": 1080,
    "timing": "voiceover",
    "audience": "Curious YouTube viewers, geography/business explainer fans",
    "notes": "Demo plan. Only three synthetic assets exist; every other media slot renders as an animatic placeholder until the asset-scout fills it."
  },
  "treatment": {
    "logline": "A 14 km gap between two continents became Africa's busiest port because Morocco built exactly where the world already sails.",
    "concept": "The strait as a doorway. The film borrows the look of a navigator's chart: deep navy, signal-yellow pen lines drawn over the world, cold real footage. Every map is a 'door' seen from above; every number is stamped like a logbook entry.",
    "why": "The script's argument is spatial (where things are) and its central metaphor is a door. A chart language makes the geography readable and gives the metaphor a visual home that can recur from hook to close.",
    "alternatives_considered": [
      "Archive-heavy history documentary (rejected: script is about the present and the future)",
      "Bright flat motion graphics (rejected: loses the weight of real ships and sea)"
    ],
    "palette": {
      "bg": "#07131f",
      "fg": "#f2efe6",
      "accent": "#ffc83d",
      "accent2": "#ff5a36",
      "muted": "#7d8fa3"
    },
    "fonts": {
      "display": "Anton",
      "body": "Inter",
      "accent": "Caveat",
      "mono": "JetBrains Mono"
    },
    "grade": "cold",
    "texture": [
      "grain",
      "vignette"
    ],
    "texture_intensity": 0.3,
    "ai_image_style": "cinematic documentary photograph, overcast cold light, muted navy and steel tones, subtle 35mm film grain, no text, no logos",
    "motifs": [
      {
        "name": "The door",
        "description": "Frames, gaps and narrow passages: the strait on the map, the gap between split panels, the frame of a polaroid.",
        "meaning": "Opportunity is a position, not a thing."
      },
      {
        "name": "The navigator's line",
        "description": "Hand-drawn signal-yellow strokes: measurement lines, routes, circles.",
        "meaning": "Someone deliberately drew this plan."
      }
    ],
    "rules": [
      "Numbers are always signal yellow.",
      "Maps are always the dark chart style.",
      "Footage is graded cold; only the final shot is warm (the payoff of the metaphor)."
    ]
  },
  "sections": [
    {
      "id": "hook",
      "title": "Hook",
      "role": "hook",
      "energy": 4
    },
    {
      "id": "context",
      "title": "A door you sail past",
      "role": "context",
      "energy": 3
    },
    {
      "id": "build",
      "title": "Tanger Med",
      "role": "build",
      "energy": 4
    },
    {
      "id": "payoff",
      "title": "Number one",
      "role": "payoff",
      "energy": 5
    },
    {
      "id": "close",
      "title": "Geography is destiny",
      "role": "recap",
      "energy": 2
    }
  ],
  "shots": [
    {
      "id": "s01",
      "section": "hook",
      "start": 0,
      "end": 1.42,
      "script": "Fourteen kilometres.",
      "hold": 0.2,
      "beat": {
        "role": "hook",
