{
  "version": "1.0",
  "meta": {
    "title": "The Black Ships — History of Japan (sample)",
    "slug": "japan-demo",
    "fps": 30,
    "width": 1920,
    "height": 1080,
    "timing": "voiceover",
    "audience": "History YouTube viewers who like hand-drawn explainers",
    "notes": "30 s sample built from only two hand-drawn illustrations: every other image is a crop, a camera move, a map or a graphic. Rendered muted on request; the narration exists only to time shots and captions."
  },
  "treatment": {
    "logline": "For a thousand years Japan's emperor lived in Kyoto behind closed borders, until four black ships ended that world in fifteen years.",
    "concept": "An illustrated history scroll being read. Hand-drawn plates on washi paper; the camera behaves like an eye reading the scroll (slow pans, pushes into details). Every date is written in ink and underlined in vermilion, and turning points get a vermilion seal.",
    "why": "It matches the channel's hand-drawn storybook art and makes two illustrations carry thirty seconds: wide plates, detail crops, maps and timelines all live on the same paper.",
    "alternatives_considered": [
      "Ukiyo-e woodblock look with flat colour fields (rejected: clashes with the colored-pencil art)",
      "Dark documentary with archive photos of Perry (rejected: no assets, and it loses the channel's charm)"
    ],
    "palette": {
      "bg": "#efe6d2",
      "fg": "#2b2622",
      "accent": "#c8432b",
      "accent2": "#2f4a6b",
      "muted": "#8a7f6a"
    },
    "fonts": {
      "display": "DM Serif Display",
      "body": "Inter",
      "accent": "Caveat",
      "mono": "JetBrains Mono"
    },
    "grade": "none",
    "texture": [
      "grain",
      "vignette"
    ],
    "texture_intensity": 0.25,
    "ai_image_style": "hand-drawn colored pencil and watercolor illustration on textured washi paper, simple round-faced characters, muted vermilion, indigo and ochre palette, storybook history style, no text",
    "motifs": [
      {
        "name": "Dates in ink",
        "description": "Each era opens on a hand-written year underlined in vermilion (794 → 1853).",
        "meaning": "The scroll's chapters."
      },
      {
        "name": "The vermilion seal",
        "description": "Turning points are stamped like a hanko seal.",
        "meaning": "Decisions by authority."
      },
      {
        "name": "Falling blossoms",
        "description": "Cherry petals over Kyoto, still falling when the old world fades.",
        "meaning": "Transience: the old Japan is beautiful and temporary."
      }
    ],
    "rules": [
      "Only the illustrations carry colour; graphics are ink plus vermilion.",
      "Every date is written by hand and underlined.",
      "The camera moves slowly like eyes across a scroll, except when the black ships arrive."
    ]
  },
