{
  "name": "visual-director-studio",
  "private": true,
  "description": "Turns Claude Code into a visual director for narrated YouTube videos: script -> shot-by-shot visual plan -> layered Remotion render.",
  "scripts": {
    "setup": "npm --prefix engine install && node engine/scripts/make-sfx.mjs",
    "new": "node engine/scripts/new-project.mjs",
    "validate": "node engine/scripts/validate.mjs",
    "retime": "node engine/scripts/retime.mjs",
    "assets": "node engine/scripts/assets.mjs",
    "storyboard": "node engine/scripts/storyboard.mjs",
    "animatic": "node engine/scripts/render.mjs --animatic",
    "render": "node engine/scripts/render.mjs",
    "export:om": "node engine/scripts/export-openmontage.mjs",
    "studio": "npm --prefix engine run studio",
    "typecheck": "npm --prefix engine run typecheck"
  }
}
