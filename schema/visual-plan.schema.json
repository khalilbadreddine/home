        },
        "props": {
          "type": "object"
        }
      },
      "unevaluatedProperties": false
    },
    "captions": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "style": {
          "enum": [
            "pop",
            "karaoke",
            "minimal"
          ],
          "default": "pop"
        },
        "position": {
          "enum": [
            "bottom",
            "center",
            "top"
          ],
          "default": "bottom"
        },
        "max_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "src": {
