        {
          "$ref": "#/$defs/layerBase"
        }
      ],
      "properties": {
        "type": {
          "const": "fx"
        },
        "effect": {
          "enum": [
            "grain",
            "vignette",
            "light_leak",
            "letterbox",
            "flash",
            "scanlines",
            "vhs",
            "dust",
            "film_burn",
            "particles",
            "tint",
            "viewfinder",
            "rec",
            "scrim"
          ]
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "kind": {
          "enum": [
            "bokeh",
            "embers",
            "dust",
            "snow"
          ],
