        },
        "font": {
          "$ref": "#/$defs/fontRole"
        },
        "uppercase": {
          "type": "boolean",
          "default": true
        },
        "hide_during": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Shot ids where captions are hidden (e.g. full-screen typography shots)."
        }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "voiceover": {
          "type": "object",
          "required": [
            "src"
          ],
          "properties": {
            "src": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 1
            },
            "offset": {
              "type": "number",
              "default": 0,
              "description": "Timeline second where the voiceover starts."
            }
          },
          "additionalProperties": false
        },
        "music": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0,
                "default": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "offset": {
                "type": "number",
                "minimum": 0,
                "description": "Skip this many seconds into the track."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.25
              },
              "fade_in": {
                "type": "number",
                "minimum": 0,
                "default": 1
              },
              "fade_out": {
                "type": "number",
                "minimum": 0,
                "default": 1.5
              },
              "duck": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.45,
