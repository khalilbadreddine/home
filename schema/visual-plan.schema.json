              },
              "mood": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sfx_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        }
      },
      "additionalProperties": false
    }
  }
}
