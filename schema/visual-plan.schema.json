          "type": "number",
          "default": 0
        },
        "to": {
          "type": "number"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "default": 0
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "count_duration": {
          "type": "number",
          "minimum": 0.1,
          "default": 1.6
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "size": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "separator": {
          "type": "boolean",
          "default": true
        }
      },
      "unevaluatedProperties": false
    },
    "annotationLayer": {
      "type": "object",
      "required": [
        "type",
        "shape"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/layerBase"
        }
      ],
      "properties": {
        "type": {
          "const": "annotation"
        },
        "shape": {
          "enum": [
            "circle",
            "box",
            "underline",
            "arrow",
            "cross",
            "pin",
            "route",
            "bracket",
            "spotlight",
            "highlight"
          ]
        },
        "at": {
          "$ref": "#/$defs/point",
          "description": "circle / pin / spotlight centre"
        },
        "radius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 80,
          "description": "% of frame height"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
