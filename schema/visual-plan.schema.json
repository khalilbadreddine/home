                "type": "string"
              },
              "date": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "fxLayer": {
      "type": "object",
      "required": [
        "type",
        "effect"
      ],
